/**
 * Copies from the NightAuth monorepo what this template mirrors, so the Astro
 * portal never drifts from the built-in customer portal:
 *   - the 10-language dictionary  (src/lib/customer/i18n.ts)
 *   - the lucide icons it draws    (node_modules/lucide-react, same version)
 *   - the language flags           (public/flags)
 *   - the Cap widget NightAuth serves (public/cap)
 *
 * Run from the repository root:  pnpm exec tsx source/portal/NightAuth-Astro-Portal/scripts/sync-from-nightauth.mts
 * The generated files are committed; a standalone copy of the template does
 * not need the monorepo.
 */
import { copyFileSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { CUSTOMER_AUTH_TRANSLATIONS, CUSTOMER_LANGS, CUSTOMER_LS_KEY } from "../../../../src/lib/customer/i18n";

const here = dirname(fileURLToPath(import.meta.url));
const template = join(here, "..");
const repo = join(template, "..", "..", "..");

const ICONS = [
  "activity", "arrow-left", "arrow-right", "calendar-days", "check", "circle-alert", "circle-check",
  "chevron-down", "clock", "copy", "download", "external-link", "eye", "eye-off", "globe", "hard-drive",
  "key", "key-round", "laptop", "layout-dashboard", "loader-circle", "lock", "log-out", "mail", "monitor",
  "monitor-smartphone", "plus", "refresh-cw", "settings", "shield", "shield-alert", "shield-check",
  "shield-off", "smartphone", "trash-2", "triangle-alert", "user", "wifi-off", "x", "zap",
];

const header = "// Generated by scripts/sync-from-nightauth.mts — do not edit by hand.\n";

writeFileSync(
  join(template, "src/i18n/portal-translations.js"),
  `${header}export const LANGS = ${JSON.stringify(CUSTOMER_LANGS, null, 2)};\n` +
    `export const LANG_STORAGE_KEY = ${JSON.stringify(CUSTOMER_LS_KEY)};\n` +
    `export const PORTAL_TRANSLATIONS = ${JSON.stringify(CUSTOMER_AUTH_TRANSLATIONS, null, 2)};\n`,
);

const lucideDir = join(repo, "node_modules/lucide-react/dist/esm/icons");
const svgAttr = (attrs: Record<string, string>) =>
  Object.entries(attrs).filter(([k]) => k !== "key").map(([k, v]) => `${k}="${v}"`).join(" ");
const icons: Record<string, string> = {};
for (const name of ICONS) {
  let source = readFileSync(join(lucideDir, `${name}.mjs`), "utf8");
  // Renamed icons are re-exports of their new module (trash-2 -> trash).
  const alias = source.match(/export \{ default \} from '\.\/([\w-]+)\.mjs'/);
  if (alias) source = readFileSync(join(lucideDir, `${alias[1]}.mjs`), "utf8");
  const match = source.match(/const __iconData = (\{[\s\S]*?\n\});/);
  if (!match) throw new Error(`Could not read icon ${name}`);
  // Trusted local package data: an object literal of [tag, attrs] nodes.
  const { node } = new Function(`return ${match[1]}`)() as { node: [string, Record<string, string>][] };
  icons[name] = node.map(([tag, attrs]) => `<${tag} ${svgAttr(attrs)}/>`).join("");
}
writeFileSync(
  join(template, "src/lib/icons.js"),
  `${header}// lucide-react v${JSON.parse(readFileSync(join(repo, "node_modules/lucide-react/package.json"), "utf8")).version} (ISC).\n` +
    `export const ICONS = ${JSON.stringify(icons, null, 2)};\n\n` +
    `/** Inline SVG markup for a lucide icon; \`cls\` sets the size/colour classes. */\n` +
    `export function icon(name, cls = "size-4") {\n` +
    `  return \`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="\${cls}" aria-hidden="true">\${ICONS[name] ?? ""}</svg>\`;\n` +
    `}\n`,
);

mkdirSync(join(template, "public/flags"), { recursive: true });
for (const file of readdirSync(join(repo, "public/flags"))) {
  copyFileSync(join(repo, "public/flags", file), join(template, "public/flags", file));
}
// NightAuth's self-hosted Cap widget (credits link removed, Apache-2.0,
// LICENSE included) and its WASM, so the portal matches the built-in one.
mkdirSync(join(template, "public/cap"), { recursive: true });
for (const file of readdirSync(join(repo, "public/cap"))) {
  copyFileSync(join(repo, "public/cap", file), join(template, "public/cap", file));
}
console.log(`synced ${CUSTOMER_LANGS.length} languages, ${ICONS.length} icons, flags, Cap widget`);
