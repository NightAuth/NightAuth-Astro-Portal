---
import "../styles/portal.css";
import { APP_NAME } from "../config.js";

interface Props {
  /** Translation key of the page name, appended to the app name in the tab title. */
  titleKey?: string;
}
const { titleKey } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{APP_NAME}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800;900&family=Geist+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen antialiased" data-title-key={titleKey}>
    <div class="min-h-screen bg-[#060608] text-white flex flex-col relative overflow-hidden">
      <svg
        id="grid"
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 inset-y-[-30%] h-[200%] w-full skew-y-12 fill-gray-400/30 stroke-gray-400/30 text-gray-400/30 [mask-image:radial-gradient(600px_circle_at_center,white,transparent)]"
      >
        <defs>
          <pattern id="grid-cell" width="40" height="40" patternUnits="userSpaceOnUse" x="-1" y="-1">
            <path d="M.5 40V.5H40" fill="none" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-cell)" />
        <svg x="-1" y="-1" class="overflow-visible" data-squares></svg>
      </svg>

      <main class="flex-1 flex flex-col items-center justify-center px-4 py-12 relative z-10">
        <slot />
      </main>

      <footer class="relative z-10 pb-6 text-center text-[11px] text-zinc-600" data-i18n="poweredBy">Powered by NightAuth</footer>
    </div>

    <script>
      import { applyTranslations } from "../lib/i18n.js";
      import { mountGrid } from "../lib/grid.js";
      applyTranslations();
      mountGrid(document.getElementById("grid"));
    </script>
  </body>
</html>
