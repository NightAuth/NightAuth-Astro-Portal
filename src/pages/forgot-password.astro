---
import Layout from "../layouts/Layout.astro";
import AuthCard from "../components/AuthCard.astro";
import Icon from "../components/Icon.astro";
---
<Layout titleKey="forgotPassword">
  <AuthCard subtitleKey="forgotPasswordSubtitle">
    <form id="forgot-form" class="p-4 space-y-4" novalidate>
      <div class="space-y-1.5">
        <label for="email" class="na-label" data-i18n="accountEmailLabel">Account Email</label>
        <div class="relative group">
          <input id="email" name="email" type="email" autocomplete="email" required class="na-input" data-i18n-placeholder="emailPlaceholder" />
          <Icon name="mail" class="size-4 na-field-icon" />
        </div>
        <p class="text-[11px] text-zinc-600" data-i18n="forgotEmailHelp"></p>
      </div>

      <div data-captcha></div>

      <button type="submit" class="ac-btn group mt-2 w-full h-11 rounded-xl font-bold text-sm text-white transition-all flex items-center justify-center gap-2 cursor-pointer">
        <span data-i18n="sendResetLinkButton">Send Reset Link</span>
        <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
      </button>

      <div class="pt-2 text-center border-t border-white/[0.04]">
        <a href="/signin" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors inline-flex items-center gap-1.5">
          <Icon name="arrow-left" class="size-3.5" />
          <span data-i18n="backToSignIn"></span>
        </a>
      </div>
    </form>

    <div id="forgot-sent" hidden class="p-8 text-center space-y-5">
      <div class="mx-auto inline-flex items-center justify-center size-16 rounded-2xl border ac-bg-12 ac-border-30 animate-pulse">
        <Icon name="circle-check" class="size-7 ac-text" />
      </div>
      <div class="space-y-2">
        <h2 class="text-lg font-extrabold text-white" data-i18n="checkInboxTitle"></h2>
        <p class="text-sm text-zinc-400 leading-relaxed" data-i18n="checkInboxBody"></p>
      </div>
      <div class="rounded-xl p-3 space-y-2 ac-bg-08 border ac-border-15">
        {["tipSpam", "tipExpires", "tipSupport"].map((key) => (
          <div class="flex items-start gap-2">
            <Icon name="circle-check" class="size-3.5 mt-0.5 flex-shrink-0 text-zinc-500" />
            <span class="text-[11px] text-zinc-500 text-left" data-i18n={key}></span>
          </div>
        ))}
      </div>
      <a href="/signin" class="inline-flex items-center justify-center gap-1.5 text-xs font-bold text-zinc-400 hover:text-white transition">
        <Icon name="arrow-left" class="size-3.5" />
        <span data-i18n="backToSignIn"></span>
      </a>
    </div>
  </AuthCard>
</Layout>

<script>
  import { api, errorMessage } from "../lib/api.js";
  import { t } from "../lib/i18n.js";
  import { loadAuthPortal } from "../lib/portal.js";
  import { setBusy, toast } from "../lib/ui.js";
  import { captchaToken, enableCaptchaFrom, mountCaptcha } from "../lib/captcha.js";
  import { checkEmail } from "../lib/validate.js";

  const form = document.getElementById("forgot-form") as HTMLFormElement;
  const submit = form.querySelector("button[type=submit]") as HTMLButtonElement;

  loadAuthPortal().then((app) => {
    if (app && !app.canForgotPassword) window.location.replace("/signin");
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
    const invalid = checkEmail(email);
    if (invalid) return toast(t(invalid), "error");
    setBusy(submit, true);
    const result = await api.forgotPassword({ email, captchaToken: captchaToken(form) });
    if (!result.ok) {
      setBusy(submit, false);
      enableCaptchaFrom(result);
      mountCaptcha(form);
      return toast(errorMessage(result), "error");
    }
    form.hidden = true;
    (document.getElementById("forgot-sent") as HTMLElement).hidden = false;
  });
</script>
