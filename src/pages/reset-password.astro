---
import Layout from "../layouts/Layout.astro";
import AuthCard from "../components/AuthCard.astro";
import Icon from "../components/Icon.astro";
---
<Layout titleKey="updatePasswordButton">
  <AuthCard subtitleKey="resetPasswordSubtitle">
    <form id="reset-form" class="p-4 space-y-4" novalidate>
      <div class="space-y-1.5">
        <label for="newPassword" class="na-label" data-i18n="newPasswordLabel">New Password</label>
        <div class="relative group">
          <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required placeholder="••••••••" class="na-input pr-10" />
          <Icon name="lock" class="size-4 na-field-icon" />
          <button type="button" data-toggle-password="newPassword" aria-label="Show password" class="absolute right-3.5 top-3.5 text-zinc-600 hover:text-zinc-400 transition cursor-pointer"></button>
        </div>
      </div>
      <div class="space-y-1.5">
        <label for="confirmPassword" class="na-label" data-i18n="confirmPasswordLabel">Confirm Password</label>
        <div class="relative group">
          <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required placeholder="••••••••" class="na-input" />
          <Icon name="lock" class="size-4 na-field-icon" />
        </div>
        <p id="reset-error" hidden class="text-[11px] text-rose-400"></p>
      </div>

      <button type="submit" class="ac-btn group mt-2 w-full h-11 rounded-xl font-bold text-sm text-white transition-all flex items-center justify-center gap-2 cursor-pointer">
        <span data-i18n="updatePasswordButton">Update Password</span>
        <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
      </button>

      <div class="pt-2 text-center border-t border-white/[0.04]">
        <a href="/signin" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors inline-flex items-center gap-1.5">
          <Icon name="arrow-left" class="size-3.5" />
          <span data-i18n="backToSignIn"></span>
        </a>
      </div>
    </form>

    <div id="reset-done" hidden class="p-8 text-center space-y-5">
      <div class="mx-auto inline-flex items-center justify-center size-16 rounded-2xl border ac-bg-12 ac-border-30">
        <Icon name="circle-check" class="size-7 ac-text" />
      </div>
      <div class="space-y-2">
        <h2 class="text-lg font-extrabold text-white" data-i18n="passwordUpdatedTitle"></h2>
        <p class="text-sm text-zinc-400 leading-relaxed" data-i18n="passwordUpdatedBody"></p>
      </div>
      <a href="/signin" class="ac-btn w-full h-11 rounded-xl font-bold text-sm text-white flex items-center justify-center gap-2">
        <span data-i18n="continueToSignIn"></span>
        <Icon name="arrow-right" class="size-4" />
      </a>
    </div>
  </AuthCard>
</Layout>

<script>
  import { api, errorMessage } from "../lib/api.js";
  import { t } from "../lib/i18n.js";
  import { loadAuthPortal } from "../lib/portal.js";
  import { setBusy, toast } from "../lib/ui.js";
  import { checkReset } from "../lib/validate.js";

  const form = document.getElementById("reset-form") as HTMLFormElement;
  const submit = form.querySelector("button[type=submit]") as HTMLButtonElement;
  const errorLine = document.getElementById("reset-error") as HTMLElement;
  const token = new URLSearchParams(window.location.search).get("token") || "";

  loadAuthPortal({ purpose: "recovery" });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!token) return toast(t("missingResetToken"), "error");
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value;
    const invalid = checkReset(value("newPassword"), value("confirmPassword"));
    errorLine.hidden = !invalid;
    if (invalid) {
      errorLine.textContent = t(invalid);
      return toast(t(invalid), "error");
    }
    setBusy(submit, true);
    const result = await api.resetPassword({ token, newPassword: value("newPassword") });
    if (!result.ok) {
      setBusy(submit, false);
      return toast(errorMessage(result), "error");
    }
    toast(t("passwordResetToast"));
    form.hidden = true;
    (document.getElementById("reset-done") as HTMLElement).hidden = false;
  });
</script>
