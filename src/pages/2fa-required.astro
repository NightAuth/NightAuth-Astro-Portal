---
import Layout from "../layouts/Layout.astro";
import AuthCard from "../components/AuthCard.astro";
import Icon from "../components/Icon.astro";
---
<Layout titleKey="authenticatorCodeLabel">
  <AuthCard subtitleKey="twoFaSubtitle">
    <form id="twofa-form" class="p-4 space-y-4" novalidate>
      <div data-mode="totp" class="space-y-3">
        <div class="flex items-center gap-2 px-1">
          <Icon name="smartphone" class="size-3.5 text-zinc-500" />
          <label for="totp" class="na-label" data-i18n="authenticatorCodeLabel">Authenticator Code</label>
        </div>
        <input id="totp" name="totp" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" placeholder="000000" autofocus
          class="na-input no-icon h-14 text-center text-2xl font-mono tracking-[0.4em]" />
        <p class="text-[11px] text-zinc-500 text-center" data-i18n="authenticatorCodeHelp"></p>
      </div>
      <div data-mode="backup" hidden class="space-y-3">
        <div class="flex items-center gap-2 px-1">
          <Icon name="key-round" class="size-3.5 text-zinc-500" />
          <label for="backup" class="na-label" data-i18n="backupRecoveryCodeLabel">Backup Recovery Code</label>
        </div>
        <input id="backup" name="backup" type="text" autocomplete="off" placeholder="XXXX-XXXX"
          class="na-input no-icon h-12 text-center font-mono tracking-widest uppercase" />
        <p class="text-[11px] text-zinc-500 text-center" data-i18n="backupRecoveryCodeHelp"></p>
      </div>

      <button type="submit" disabled class="ac-btn group mt-2 w-full h-11 rounded-xl font-bold text-sm text-white transition-all flex items-center justify-center gap-2 cursor-pointer">
        <span data-i18n="verifyAndContinueButton">Verify &amp; Continue</span>
        <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
      </button>

      <div class="pt-2 flex items-center justify-between border-t border-white/[0.04]">
        <button type="button" data-toggle-mode class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors cursor-pointer" data-i18n="useBackupCode"></button>
        <a href="/signin" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors">← <span data-i18n="backToSignIn"></span></a>
      </div>
    </form>
  </AuthCard>
</Layout>

<script>
  import { api, errorMessage } from "../lib/api.js";
  import { t } from "../lib/i18n.js";
  import { loadAuthPortal } from "../lib/portal.js";
  import { setBusy, toast } from "../lib/ui.js";
  import { checkCode } from "../lib/validate.js";

  const form = document.getElementById("twofa-form") as HTMLFormElement;
  const submit = form.querySelector("button[type=submit]") as HTMLButtonElement;
  const totp = document.getElementById("totp") as HTMLInputElement;
  const backup = document.getElementById("backup") as HTMLInputElement;
  const toggle = form.querySelector("[data-toggle-mode]") as HTMLButtonElement;
  let isBackup = false;

  const code = () => (isBackup ? backup.value.trim() : totp.value);
  const refresh = () => (submit.disabled = isBackup ? code().length < 8 : code().length !== 6);
  totp.addEventListener("input", () => {
    totp.value = totp.value.replace(/\D/g, "").slice(0, 6);
    refresh();
  });
  backup.addEventListener("input", () => {
    backup.value = backup.value.toUpperCase();
    refresh();
  });
  toggle.addEventListener("click", () => {
    isBackup = !isBackup;
    totp.value = backup.value = "";
    form.querySelectorAll<HTMLElement>("[data-mode]").forEach((el) => (el.hidden = (el.dataset.mode === "backup") !== isBackup));
    toggle.dataset.i18n = isBackup ? "useAuthenticatorApp" : "useBackupCode";
    toggle.textContent = t(toggle.dataset.i18n);
    (isBackup ? backup : totp).focus();
    refresh();
  });

  loadAuthPortal();

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const invalid = checkCode(code());
    if (invalid) return toast(t(invalid), "error");
    setBusy(submit, true);
    const result = await api.verify2fa({ code: code(), isBackup });
    if (!result.ok) {
      setBusy(submit, false);
      return toast(errorMessage(result, "invalidCodeToast"), "error");
    }
    toast(t("identityVerifiedToast"));
    window.location.assign("/");
  });
</script>
